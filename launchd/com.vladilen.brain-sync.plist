<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- brain sync каждые 15 минут. Установка и удаление — в README, раздел «Автозапуск». -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.vladilen.brain-sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/vladilen/brain/bin/brain</string>
        <string>sync</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <!-- иначе Python копит вывод в буфере и лог пустой до конца прогона -->
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
    <!-- По часам: :00, :15, :30, :45. StartInterval с ProcessType Background
         macOS откладывала на десятки минут. Если Mac спал, пропущенный запуск
         выполнится при пробуждении. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Minute</key><integer>0</integer></dict>
        <dict><key>Minute</key><integer>15</integer></dict>
        <dict><key>Minute</key><integer>30</integer></dict>
        <dict><key>Minute</key><integer>45</integer></dict>
    </array>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/Users/vladilen/Library/Logs/brain-sync.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/vladilen/Library/Logs/brain-sync.log</string>
</dict>
</plist>
