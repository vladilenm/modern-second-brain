{
  "llm": {
    "base_url": "https://openrouter.ai/api/v1",
    "api_key": "ВСТАВЬ_КЛЮЧ",
    "model": "название-модели",
    "json_mode": true,
    "batch_limit": 40
  },
  "exclude_projects": [
    "~/Documents/dev/автоматический-бот"
  ],
  "topic_stopwords": ["имя фамилия", "ник"],
  "project_aliases": {"имя-репозитория": "имя-папки"},
  "project_ignore": ["~/папка-с-прогонами/*"],
  "search": {
    "half_life_days": 120,
    "recency_weight": 0.35
  },
  "sources": {
    "claude_code": {"enabled": true},
    "codex": {"enabled": true},
    "kimi": {"enabled": true},
    "chatgpt_export": {"enabled": true},
    "github": {"enabled": true, "every_minutes": 60, "backfill_days": 730, "exclude_repos": []},
    "gmail": {"enabled": false, "address": "", "every_minutes": 15, "backfill_days": 730, "summarize": true},
    "yandex_mail": {"enabled": false, "address": "", "every_minutes": 15, "backfill_days": 730, "summarize": true},
    "notion": {"enabled": false, "every_minutes": 15, "summarize": true, "max_pages_per_run": 100},
    "youtube": {"enabled": false, "channels": ["@твой-канал"], "every_minutes": 360, "comments_per_video": 30, "max_videos_per_run": 100}
  }
}
